# No Gemini API key is needed in this app. Gemini is called through Firebase AI Logic,
# where Google keeps the key on its side. See DEPLOY.md for the one-time console setup.

# App Check (required by Firebase AI Logic). A PUBLIC reCAPTCHA Enterprise site key, not a secret.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=""

# Local development only (optional): a debug token you registered in Firebase console > App Check.
# Never use this in a production build.
VITE_APPCHECK_DEBUG_TOKEN=""
